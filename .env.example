# Salin jadi .env lalu isi. Di Render, isi di Environment (bukan di file).
# Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Nomor WhatsApp pemesanan (format internasional, tanpa + dan tanpa spasi), mis. 6281234567890
VITE_WA_NUMBER=

# Alamat situs setelah online (dipakai untuk isi QR paspor), mis. https://pande.onrender.com
VITE_SITE_URL=
